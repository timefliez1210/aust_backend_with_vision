# ---- Build stage ----
FROM rust:1.88-bookworm AS builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests + source + template (template is embedded via include_bytes! at compile time)
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY src ./src
COPY migrations ./migrations
COPY templates ./templates
COPY config ./config

RUN cargo build --release

# ---- whisper.cpp (local speech-to-text for Telegram voice notes) ----
# Static build, so the runtime image gets one self-contained binary. AVX2/FMA/F16C
# only: the image is built on the laptop (no AVX-512) and must also run on the VPS.
FROM debian:bookworm-slim AS whisper
ARG WHISPER_CPP_REF=v1.9.5
RUN apt-get update && apt-get install -y git cmake g++ make ca-certificates --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${WHISPER_CPP_REF} https://github.com/ggml-org/whisper.cpp.git /whisper \
    && cmake -S /whisper -B /whisper/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
         -DWHISPER_BUILD_TESTS=OFF -DGGML_NATIVE=OFF -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON \
    && cmake --build /whisper/build -j"$(nproc)" --target whisper-cli \
    && cp /whisper/build/bin/whisper-cli /usr/local/bin/whisper-cli

# ---- ONNX Runtime (Josie's local embeddings, loaded at runtime via ORT_DYLIB_PATH) ----
# ort's prebuilt static library needs a newer libstdc++ than bookworm ships, so the
# binary dlopens Microsoft's official build instead. Must be >= 1.24 (ort api-24).
FROM debian:bookworm-slim AS onnxruntime
ARG ORT_VERSION=1.24.4
RUN apt-get update && apt-get install -y curl ca-certificates --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-${ORT_VERSION}.tgz \
    | tar -xz -C /opt \
    && cp -L /opt/onnxruntime-linux-x64-${ORT_VERSION}/lib/libonnxruntime.so /usr/local/lib/libonnxruntime.so

# ---- Runtime stage ----
FROM debian:bookworm-slim

# fonts-crosextra-carlito is the metric-compatible stand-in for Calibri, the font
# the KVA/Rechnung templates are laid out in. Without it LibreOffice substitutes a
# wider face and the signature lines on the KVA's terms page wrap onto a second line.
RUN echo "deb http://deb.debian.org/debian bookworm main contrib" > /etc/apt/sources.list.d/contrib.list \
    && apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    tzdata \
    libreoffice-calc \
    fonts-crosextra-carlito \
    poppler-utils \
    libgomp1 \
    ffmpeg \
    libheif-examples \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/aust_backend ./aust_backend
# The model is not baked in (~190–570 MB): it lives in /opt/aust/whisper on the
# host, mounted at /app/whisper, and AUST__VOICE__MODEL_PATH points at it.
COPY --from=whisper /usr/local/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=onnxruntime /usr/local/lib/libonnxruntime.so /usr/local/lib/libonnxruntime.so
ENV ORT_DYLIB_PATH=/usr/local/lib/libonnxruntime.so
COPY config ./config
COPY migrations ./migrations
# Assistant persona file — the binary loads SOUL.md from the working dir at startup.
COPY crates/assistant/prompts/SOUL.md ./SOUL.md

RUN useradd -u 1000 -m aust && chown -R aust:aust /app
USER aust

EXPOSE 8080
ENV RUN_MODE=staging

CMD ["./aust_backend"]
